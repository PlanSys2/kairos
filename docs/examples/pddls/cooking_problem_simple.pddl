; One robot, one kitchen, an omelette; the battery is low, so it has to recharge on the way
(define (problem cooking_simple)
  (:domain cooking)
  (:objects
    r1 - robot
    recharge_zone fridge pantry watertap kitchen1 - zone
    egg oil salt flour sugar pasta water - ingredient
    omelette1 - dish
  )
  (:init
    (robot_at r1 recharge_zone)
    (robot_free r1)
    (= (battery r1) 30)
    (is_recharge_zone recharge_zone)
    (is_fridge_zone fridge)
    (is_pantry_zone pantry)
    (is_watertap_zone watertap)
    (is_cooking_zone kitchen1)
    (stove_free kitchen1)
    (is_egg egg)
    (= (stock egg recharge_zone) 0)
    (= (stock egg fridge) 1)
    (= (stock egg pantry) 0)
    (= (stock egg watertap) 0)
    (= (stock egg kitchen1) 0)
    (is_oil oil)
    (= (stock oil recharge_zone) 0)
    (= (stock oil fridge) 0)
    (= (stock oil pantry) 1)
    (= (stock oil watertap) 0)
    (= (stock oil kitchen1) 0)
    (is_salt salt)
    (= (stock salt recharge_zone) 0)
    (= (stock salt fridge) 0)
    (= (stock salt pantry) 1)
    (= (stock salt watertap) 0)
    (= (stock salt kitchen1) 0)
    (is_flour flour)
    (= (stock flour recharge_zone) 0)
    (= (stock flour fridge) 0)
    (= (stock flour pantry) 0)
    (= (stock flour watertap) 0)
    (= (stock flour kitchen1) 0)
    (is_sugar sugar)
    (= (stock sugar recharge_zone) 0)
    (= (stock sugar fridge) 0)
    (= (stock sugar pantry) 0)
    (= (stock sugar watertap) 0)
    (= (stock sugar kitchen1) 0)
    (is_pasta pasta)
    (= (stock pasta recharge_zone) 0)
    (= (stock pasta fridge) 0)
    (= (stock pasta pantry) 0)
    (= (stock pasta watertap) 0)
    (= (stock pasta kitchen1) 0)
    (is_water water)
    (= (stock water recharge_zone) 0)
    (= (stock water fridge) 0)
    (= (stock water pantry) 0)
    (= (stock water watertap) 0)
    (= (stock water kitchen1) 0)
    (is_omelette omelette1)
  )
  (:goal (and
    (dish_prepared omelette1)
  ))
)
