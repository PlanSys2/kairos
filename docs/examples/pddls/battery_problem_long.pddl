; Three robots on a 4x4 grid of waypoints (20 m apart), chargers in three corners.
; Each starts with 30 of battery: 16 waypoints to visit, so they recharge on the way.
(define (problem battery_problem_long)
  (:domain battery_patrol)
  (:objects
    r1 r2 r3 - robot
    wp00 wp01 wp02 wp03 wp10 wp11 wp12 wp13 wp20 wp21 wp22 wp23 wp30 wp31 wp32 wp33 - waypoint)
  (:init
    (robot_at r1 wp00)
    (robot_free r1)
    (= (battery r1) 30)
    (= (capacity r1) 100)
    (= (discharge_rate r1) 1)
    (= (charge_rate r1) 10)
    (= (speed r1) 1)
    (robot_at r2 wp30)
    (robot_free r2)
    (= (battery r2) 30)
    (= (capacity r2) 100)
    (= (discharge_rate r2) 1)
    (= (charge_rate r2) 10)
    (= (speed r2) 1)
    (robot_at r3 wp03)
    (robot_free r3)
    (= (battery r3) 30)
    (= (capacity r3) 100)
    (= (discharge_rate r3) 1)
    (= (charge_rate r3) 10)
    (= (speed r3) 1)
    (charger_at wp00)
    (charger_at wp30)
    (charger_at wp03)
    (connected wp00 wp10)
    (= (distance wp00 wp10) 20)
    (connected wp10 wp00)
    (= (distance wp10 wp00) 20)
    (connected wp01 wp11)
    (= (distance wp01 wp11) 20)
    (connected wp11 wp01)
