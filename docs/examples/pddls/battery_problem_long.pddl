    (connected wp33 wp23)
    (= (distance wp33 wp23) 20)
    (connected wp00 wp01)
    (= (distance wp00 wp01) 20)
    (connected wp01 wp00)
    (= (distance wp01 wp00) 20)
    (connected wp01 wp02)
    (= (distance wp01 wp02) 20)
    (connected wp02 wp01)
    (= (distance wp02 wp01) 20)
    (connected wp02 wp03)
    (= (distance wp02 wp03) 20)
    (connected wp03 wp02)
    (= (distance wp03 wp02) 20)
    (connected wp10 wp11)
