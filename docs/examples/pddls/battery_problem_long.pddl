    (= (distance wp10 wp20) 20)
    (connected wp20 wp10)
    (= (distance wp20 wp10) 20)
    (connected wp11 wp21)
    (= (distance wp11 wp21) 20)
    (connected wp21 wp11)
    (= (distance wp21 wp11) 20)
    (connected wp12 wp22)
    (= (distance wp12 wp22) 20)
    (connected wp22 wp12)
    (= (distance wp22 wp12) 20)
    (connected wp13 wp23)
    (= (distance wp13 wp23) 20)
