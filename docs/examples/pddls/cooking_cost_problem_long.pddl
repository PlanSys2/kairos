; Two robots, two kitchens, two of each dish; oil, salt, sugar and tomato run short
; Minimum cost: 34
(define (problem cooking_cost_long)
  (:domain cooking_cost)
  (:objects
    r1 r2 - robot
    fridge pantry watertap kitchen1 kitchen2 - zone
    egg flour pasta water oil butter salt pepper herbs sugar honey tomato pesto cream - ingredient
    omelette1 omelette2 cake1 cake2 spaghetti1 spaghetti2 - dish
  )
  (:init
    (robot_at r1 fridge)
    (robot_free r1)
    (robot_at r2 pantry)
    (robot_free r2)
    (is_cooking_zone kitchen1)
    (stove_free kitchen1)
    (is_cooking_zone kitchen2)
    (stove_free kitchen2)
    (is_egg egg)
    (= (price egg) 2)
    (= (stock egg fridge) 10)
    (= (stock egg pantry) 0)
    (= (stock egg watertap) 0)
    (= (stock egg kitchen1) 0)
    (= (stock egg kitchen2) 0)
    (is_flour flour)
    (= (price flour) 1)
    (= (stock flour fridge) 0)
    (= (stock flour pantry) 10)
    (= (stock flour watertap) 0)
    (= (stock flour kitchen1) 0)
    (= (stock flour kitchen2) 0)
    (is_pasta pasta)
    (= (price pasta) 2)
    (= (stock pasta fridge) 0)
    (= (stock pasta pantry) 10)
    (= (stock pasta watertap) 0)
    (= (stock pasta kitchen1) 0)
    (= (stock pasta kitchen2) 0)
    (is_water water)
    (= (price water) 0)
    (= (stock water fridge) 0)
    (= (stock water pantry) 0)
    (= (stock water watertap) 10)
    (= (stock water kitchen1) 0)
    (= (stock water kitchen2) 0)
    (is_fat oil)
    (= (price oil) 1)
    (= (stock oil fridge) 0)
    (= (stock oil pantry) 2)
    (= (stock oil watertap) 0)
    (= (stock oil kitchen1) 0)
    (= (stock oil kitchen2) 0)
    (is_fat butter)
    (= (price butter) 3)
    (= (stock butter fridge) 10)
    (= (stock butter pantry) 0)
    (= (stock butter watertap) 0)
    (= (stock butter kitchen1) 0)
    (= (stock butter kitchen2) 0)
    (is_seasoning salt)
    (= (price salt) 0)
    (= (stock salt fridge) 0)
    (= (stock salt pantry) 2)
    (= (stock salt watertap) 0)
    (= (stock salt kitchen1) 0)
    (= (stock salt kitchen2) 0)
    (is_seasoning pepper)
    (= (price pepper) 1)
    (= (stock pepper fridge) 0)
    (= (stock pepper pantry) 10)
    (= (stock pepper watertap) 0)
    (= (stock pepper kitchen1) 0)
    (= (stock pepper kitchen2) 0)
    (is_seasoning herbs)
    (= (price herbs) 2)
    (= (stock herbs fridge) 10)
    (= (stock herbs pantry) 0)
    (= (stock herbs watertap) 0)
    (= (stock herbs kitchen1) 0)
    (= (stock herbs kitchen2) 0)
    (is_sweetener sugar)
    (= (price sugar) 1)
    (= (stock sugar fridge) 0)
    (= (stock sugar pantry) 1)
    (= (stock sugar watertap) 0)
    (= (stock sugar kitchen1) 0)
    (= (stock sugar kitchen2) 0)
    (is_sweetener honey)
    (= (price honey) 4)
    (= (stock honey fridge) 0)
    (= (stock honey pantry) 10)
    (= (stock honey watertap) 0)
    (= (stock honey kitchen1) 0)
    (= (stock honey kitchen2) 0)
