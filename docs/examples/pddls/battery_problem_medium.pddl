; Two robots on a ring of 8 waypoints (46 m apart), chargers at wp0 and wp4.
; Each starts with 40 of battery: visiting every waypoint needs recharges on the way.
(define (problem battery_problem_medium)
  (:domain battery_patrol)
  (:objects
    r1 r2 - robot
    wp0 wp1 wp2 wp3 wp4 wp5 wp6 wp7 - waypoint)
  (:init
    (robot_at r1 wp0)
    (robot_free r1)
    (= (battery r1) 40)
    (= (capacity r1) 100)
    (= (discharge_rate r1) 1)
    (= (charge_rate r1) 10)
    (= (speed r1) 1)
    (robot_at r2 wp4)
    (robot_free r2)
    (= (battery r2) 40)
    (= (capacity r2) 100)
    (= (discharge_rate r2) 1)
    (= (charge_rate r2) 10)
    (= (speed r2) 1)
    (charger_at wp0)
    (charger_at wp4)
    (connected wp0 wp1)
    (= (distance wp0 wp1) 46)
    (connected wp1 wp0)
    (= (distance wp1 wp0) 46)
    (connected wp1 wp2)
    (= (distance wp1 wp2) 46)
    (connected wp2 wp1)
    (= (distance wp2 wp1) 46)
    (connected wp2 wp3)
    (= (distance wp2 wp3) 46)
    (connected wp3 wp2)
    (= (distance wp3 wp2) 46)
    (connected wp3 wp4)
    (= (distance wp3 wp4) 46)
    (connected wp4 wp3)
    (= (distance wp4 wp3) 46)
    (connected wp4 wp5)
    (= (distance wp4 wp5) 46)
    (connected wp5 wp4)
    (= (distance wp5 wp4) 46)
    (connected wp5 wp6)
    (= (distance wp5 wp6) 46)
    (connected wp6 wp5)
    (= (distance wp6 wp5) 46)
    (connected wp6 wp7)
    (= (distance wp6 wp7) 46)
    (connected wp7 wp6)
    (= (distance wp7 wp6) 46)
    (connected wp7 wp0)
    (= (distance wp7 wp0) 46)
    (connected wp0 wp7)
    (= (distance wp0 wp7) 46)
  )
  (:goal (and
    (visited wp0)
    (visited wp1)
    (visited wp2)
    (visited wp3)
    (visited wp4)
    (visited wp5)
    (visited wp6)
    (visited wp7)
  ))
)
