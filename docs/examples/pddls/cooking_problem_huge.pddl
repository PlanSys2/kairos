; Four robots, three kitchens, 18 dishes (6 of each): about 60 units to carry and many recharges
(define (problem cooking_huge)
  (:domain cooking)
  (:objects
    r1 r2 r3 r4 - robot
    recharge_zone fridge pantry watertap kitchen1 kitchen2 kitchen3 - zone
    egg oil salt flour sugar pasta water - ingredient
    omelette1 cake1 spaghetti1 omelette2 cake2 spaghetti2 omelette3 cake3 spaghetti3 omelette4 cake4 spaghetti4 omelette5 cake5 spaghetti5 omelette6 cake6 spaghetti6 - dish
  )
  (:init
    (robot_at r1 recharge_zone)
    (robot_free r1)
    (= (battery r1) 50)
    (robot_at r2 pantry)
    (robot_free r2)
    (= (battery r2) 50)
    (robot_at r3 fridge)
    (robot_free r3)
    (= (battery r3) 50)
    (robot_at r4 watertap)
    (robot_free r4)
    (= (battery r4) 50)
    (is_recharge_zone recharge_zone)
    (is_fridge_zone fridge)
    (is_pantry_zone pantry)
    (is_watertap_zone watertap)
    (is_cooking_zone kitchen1)
    (stove_free kitchen1)
    (is_cooking_zone kitchen2)
    (stove_free kitchen2)
    (is_cooking_zone kitchen3)
    (stove_free kitchen3)
    (is_egg egg)
    (= (stock egg recharge_zone) 0)
    (= (stock egg fridge) 12)
    (= (stock egg pantry) 0)
    (= (stock egg watertap) 0)
    (= (stock egg kitchen1) 0)
    (= (stock egg kitchen2) 0)
    (= (stock egg kitchen3) 0)
    (is_oil oil)
    (= (stock oil recharge_zone) 0)
    (= (stock oil fridge) 0)
    (= (stock oil pantry) 12)
    (= (stock oil watertap) 0)
    (= (stock oil kitchen1) 0)
    (= (stock oil kitchen2) 0)
    (= (stock oil kitchen3) 0)
    (is_salt salt)
    (= (stock salt recharge_zone) 0)
    (= (stock salt fridge) 0)
    (= (stock salt pantry) 12)
    (= (stock salt watertap) 0)
    (= (stock salt kitchen1) 0)
    (= (stock salt kitchen2) 0)
    (= (stock salt kitchen3) 0)
    (is_flour flour)
    (= (stock flour recharge_zone) 0)
    (= (stock flour fridge) 0)
    (= (stock flour pantry) 6)
    (= (stock flour watertap) 0)
    (= (stock flour kitchen1) 0)
    (= (stock flour kitchen2) 0)
    (= (stock flour kitchen3) 0)
    (is_sugar sugar)
    (= (stock sugar recharge_zone) 0)
    (= (stock sugar fridge) 0)
    (= (stock sugar pantry) 6)
    (= (stock sugar watertap) 0)
    (= (stock sugar kitchen1) 0)
    (= (stock sugar kitchen2) 0)
    (= (stock sugar kitchen3) 0)
    (is_pasta pasta)
    (= (stock pasta recharge_zone) 0)
    (= (stock pasta fridge) 0)
    (= (stock pasta pantry) 6)
    (= (stock pasta watertap) 0)
    (= (stock pasta kitchen1) 0)
    (= (stock pasta kitchen2) 0)
    (= (stock pasta kitchen3) 0)
    (is_water water)
    (= (stock water recharge_zone) 0)
    (= (stock water fridge) 0)
    (= (stock water pantry) 0)
    (= (stock water watertap) 6)
    (= (stock water kitchen1) 0)
    (= (stock water kitchen2) 0)
    (= (stock water kitchen3) 0)
    (is_omelette omelette1)
    (is_cake cake1)
    (is_spaghetti spaghetti1)
    (is_omelette omelette2)
    (is_cake cake2)
    (is_spaghetti spaghetti2)
    (is_omelette omelette3)
    (is_cake cake3)
    (is_spaghetti spaghetti3)
    (is_omelette omelette4)
    (is_cake cake4)
    (is_spaghetti spaghetti4)
    (is_omelette omelette5)
    (is_cake cake5)
    (is_spaghetti spaghetti5)
    (is_omelette omelette6)
    (is_cake cake6)
    (is_spaghetti spaghetti6)
  )
  (:goal (and
    (dish_prepared omelette1)
    (dish_prepared cake1)
    (dish_prepared spaghetti1)
    (dish_prepared omelette2)
    (dish_prepared cake2)
    (dish_prepared spaghetti2)
    (dish_prepared omelette3)
    (dish_prepared cake3)
    (dish_prepared spaghetti3)
    (dish_prepared omelette4)
    (dish_prepared cake4)
    (dish_prepared spaghetti4)
    (dish_prepared omelette5)
    (dish_prepared cake5)
    (dish_prepared spaghetti5)
    (dish_prepared omelette6)
    (dish_prepared cake6)
    (dish_prepared spaghetti6)
  ))
)
