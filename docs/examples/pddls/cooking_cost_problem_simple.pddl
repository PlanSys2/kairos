; One robot, one kitchen, an omelette: oil and salt are the cheap choices
; Minimum cost: 3
(define (problem cooking_cost_simple)
  (:domain cooking_cost)
  (:objects
    r1 - robot
    fridge pantry watertap kitchen1 - zone
    egg flour pasta water oil butter salt pepper herbs sugar honey tomato pesto cream - ingredient
    omelette1 - dish
  )
  (:init
    (robot_at r1 fridge)
    (robot_free r1)
    (is_cooking_zone kitchen1)
    (stove_free kitchen1)
    (is_egg egg)
    (= (price egg) 2)
    (= (stock egg fridge) 10)
    (= (stock egg pantry) 0)
    (= (stock egg watertap) 0)
    (= (stock egg kitchen1) 0)
    (is_flour flour)
    (= (price flour) 1)
    (= (stock flour fridge) 0)
    (= (stock flour pantry) 10)
    (= (stock flour watertap) 0)
    (= (stock flour kitchen1) 0)
    (is_pasta pasta)
    (= (price pasta) 2)
    (= (stock pasta fridge) 0)
    (= (stock pasta pantry) 10)
    (= (stock pasta watertap) 0)
    (= (stock pasta kitchen1) 0)
    (is_water water)
    (= (price water) 0)
    (= (stock water fridge) 0)
    (= (stock water pantry) 0)
    (= (stock water watertap) 10)
    (= (stock water kitchen1) 0)
    (is_fat oil)
    (= (price oil) 1)
    (= (stock oil fridge) 0)
    (= (stock oil pantry) 1)
    (= (stock oil watertap) 0)
    (= (stock oil kitchen1) 0)
    (is_fat butter)
    (= (price butter) 3)
    (= (stock butter fridge) 10)
    (= (stock butter pantry) 0)
    (= (stock butter watertap) 0)
    (= (stock butter kitchen1) 0)
    (is_seasoning salt)
    (= (price salt) 0)
    (= (stock salt fridge) 0)
    (= (stock salt pantry) 1)
    (= (stock salt watertap) 0)
    (= (stock salt kitchen1) 0)
    (is_seasoning pepper)
    (= (price pepper) 1)
    (= (stock pepper fridge) 0)
    (= (stock pepper pantry) 10)
    (= (stock pepper watertap) 0)
    (= (stock pepper kitchen1) 0)
    (is_seasoning herbs)
    (= (price herbs) 2)
    (= (stock herbs fridge) 10)
    (= (stock herbs pantry) 0)
    (= (stock herbs watertap) 0)
    (= (stock herbs kitchen1) 0)
    (is_sweetener sugar)
    (= (price sugar) 1)
    (= (stock sugar fridge) 0)
    (= (stock sugar pantry) 10)
    (= (stock sugar watertap) 0)
    (= (stock sugar kitchen1) 0)
    (is_sweetener honey)
    (= (price honey) 4)
    (= (stock honey fridge) 0)
    (= (stock honey pantry) 10)
    (= (stock honey watertap) 0)
    (= (stock honey kitchen1) 0)
    (is_sauce tomato)
    (= (price tomato) 2)
    (= (stock tomato fridge) 10)
    (= (stock tomato pantry) 0)
    (= (stock tomato watertap) 0)
    (= (stock tomato kitchen1) 0)
    (is_sauce pesto)
    (= (price pesto) 4)
    (= (stock pesto fridge) 10)
    (= (stock pesto pantry) 0)
    (= (stock pesto watertap) 0)
    (= (stock pesto kitchen1) 0)
    (is_sauce cream)
    (= (price cream) 3)
    (= (stock cream fridge) 10)
    (= (stock cream pantry) 0)
    (= (stock cream watertap) 0)
    (= (stock cream kitchen1) 0)
    (is_omelette omelette1)
    (= (total-cost) 0)
  )
  (:goal (and
    (dish_prepared omelette1)
  ))
  (:metric minimize (total-cost))
)
