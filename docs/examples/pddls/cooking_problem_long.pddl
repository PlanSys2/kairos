; Two robots, two kitchens, six dishes (2 omelettes, 2 cakes, 2 spaghetti); every unit carried one by one
(define (problem cooking_long)
  (:domain cooking)
  (:objects
    r1 r2 - robot
    recharge_zone fridge pantry watertap kitchen1 kitchen2 - zone
    egg oil salt flour sugar pasta water - ingredient
    omelette1 cake1 spaghetti1 omelette2 cake2 spaghetti2 - dish
  )
  (:init
    (robot_at r1 recharge_zone)
    (robot_free r1)
    (= (battery r1) 60)
    (robot_at r2 pantry)
    (robot_free r2)
    (= (battery r2) 60)
    (is_recharge_zone recharge_zone)
    (is_fridge_zone fridge)
    (is_pantry_zone pantry)
    (is_watertap_zone watertap)
    (is_cooking_zone kitchen1)
    (stove_free kitchen1)
    (is_cooking_zone kitchen2)
    (stove_free kitchen2)
    (is_egg egg)
    (= (stock egg recharge_zone) 0)
    (= (stock egg fridge) 4)
    (= (stock egg pantry) 0)
    (= (stock egg watertap) 0)
    (= (stock egg kitchen1) 0)
    (= (stock egg kitchen2) 0)
    (is_oil oil)
    (= (stock oil recharge_zone) 0)
    (= (stock oil fridge) 0)
    (= (stock oil pantry) 4)
    (= (stock oil watertap) 0)
    (= (stock oil kitchen1) 0)
    (= (stock oil kitchen2) 0)
    (is_salt salt)
    (= (stock salt recharge_zone) 0)
    (= (stock salt fridge) 0)
    (= (stock salt pantry) 4)
    (= (stock salt watertap) 0)
    (= (stock salt kitchen1) 0)
    (= (stock salt kitchen2) 0)
    (is_flour flour)
    (= (stock flour recharge_zone) 0)
    (= (stock flour fridge) 0)
    (= (stock flour pantry) 2)
    (= (stock flour watertap) 0)
    (= (stock flour kitchen1) 0)
    (= (stock flour kitchen2) 0)
    (is_sugar sugar)
    (= (stock sugar recharge_zone) 0)
    (= (stock sugar fridge) 0)
    (= (stock sugar pantry) 2)
    (= (stock sugar watertap) 0)
    (= (stock sugar kitchen1) 0)
    (= (stock sugar kitchen2) 0)
    (is_pasta pasta)
    (= (stock pasta recharge_zone) 0)
    (= (stock pasta fridge) 0)
    (= (stock pasta pantry) 2)
    (= (stock pasta watertap) 0)
    (= (stock pasta kitchen1) 0)
    (= (stock pasta kitchen2) 0)
    (is_water water)
    (= (stock water recharge_zone) 0)
    (= (stock water fridge) 0)
    (= (stock water pantry) 0)
    (= (stock water watertap) 2)
    (= (stock water kitchen1) 0)
    (= (stock water kitchen2) 0)
    (is_omelette omelette1)
    (is_cake cake1)
    (is_spaghetti spaghetti1)
    (is_omelette omelette2)
    (is_cake cake2)
    (is_spaghetti spaghetti2)
  )
  (:goal (and
    (dish_prepared omelette1)
    (dish_prepared cake1)
    (dish_prepared spaghetti1)
    (dish_prepared omelette2)
    (dish_prepared cake2)
    (dish_prepared spaghetti2)
  ))
)
